signer "payer" "svm::secret_key" {
    description = "Pays for deployment and for cranking every symbol"
    keypair_json = "~/.config/solana/id.json"
}

signer "authority" "svm::secret_key" {
    description = "Owns each feed descriptor and each symbol's adapter config"
    keypair_json = "~/.config/solana/id.json"
}
