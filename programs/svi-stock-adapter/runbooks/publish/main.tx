            symbol                 = variable.nvda_symbol,
            svi_core_program       = std::encode_base58(action.deploy_svi_core.program_id),
            fair_descriptor        = variable.nvda_fair_descriptor.pda,
            fair_quote             = variable.nvda_fair_quote.pda,
            market_descriptor      = variable.nvda_market_descriptor.pda,
            market_quote           = variable.nvda_market_quote.pda,
            equity_feed_id         = variable.nvda_equity_feed_id,
            token_feed_id          = variable.nvda_token_feed_id,
            market_closed_secs     = 900,
            reference_stale_secs   = 345600,
            reference_max_age_secs = 691200,
            token_stale_secs       = 120,
            token_max_age_secs     = 1800,
            max_deviation_bps      = 200,
            max_conf_bps           = 500,
            methodology_hash       = variable.methodology_hash,
            base_decimals          = 0,
            min_verification_level = 0
        }]
        authority { public_key = signer.authority.public_key }
        config { public_key = variable.nvda_config.pda }
        adapter_authority { public_key = variable.adapter_authority.pda }
    }
    signers = [signer.authority]
    depends_on = [action.init_nvda_market_feed]
}

output "nvda_fair_quote" {
    description = "NVDA fair value -- what the real share is worth"
    value = variable.nvda_fair_quote.pda
}
output "nvda_market_quote" {
    description = "NVDA market price -- what the token trades at on Solana"
    value = variable.nvda_market_quote.pda
}
