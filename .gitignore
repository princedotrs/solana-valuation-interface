
# local tooling installs, not project content
.agents/
.claude/skills/colosseum-copilot

# Python bytecode from scripts/
__pycache__/
*.pyc

# Copied into site/ at deploy time by netlify.toml; the root file is the source.
site/deployments.json

# Working notes and raw chat transcripts. Not part of the project.
docs/context/

# Rust build output, at any depth. Each crate also carries its own rule, but a
# new crate is easy to add without one -- which is exactly how 577 MB of
# tools/stock-check/target got committed. This rule is the backstop.
target/

# macOS finder droppings
.DS_Store

# surfpool's per-run simnet logs at the repo root. Each `surfpool start` writes
# a new timestamped file here, so left untracked this grows without bound.
# (programs/svi-stock-adapter/.gitignore has its own rule for its nested copy.)
/.surfpool/

# Generated by scripts/plan-deployment.py, together with deployments.json, from
# one derivation in one run. Tracking it invites exactly the failure it exists
# to prevent: a committed copy from someone else's symbols and program ids
# silently replacing the one that matches your deployments.json, leaving the
# runbook and every reader disagreeing about addresses. Regenerate, never pull.
#
# The svi-core and svi-hylo-adapter runbooks are hand-written and stay tracked.
programs/svi-stock-adapter/runbooks/publish/main.tx
